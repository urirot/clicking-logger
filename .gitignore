.DS_Store
node_modules/
package-lock.json
dist/
.firebase/

# Native build output. The ios/ and android/ projects are committed — they hold
# hand-edited config (portrait lock, display name, encryption declaration) and
# the generated icon and splash sets, which a CI runner with no Xcode and no
# Android SDK cannot regenerate. Only their copied web assets are excluded.
dist-native/
ios/App/App/public/
android/app/src/main/assets/public/
ios/App/App/capacitor.config.json
android/app/src/main/assets/capacitor.config.json
ios/App/Pods/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/capacitor-cordova-android-plugins/build/

# Signing. The upload keystore lives outside the repo (tools/make-upload-keystore.sh);
# this file holds its path and password, so it must never be committed.
android/keystore.properties
*.jks
*.keystore
*.p12
*.mobileprovision

# Generated from icon-1024.png by tools/make-native-assets.sh. The platform sets
# under ios/ and android/ ARE committed; these intermediates need not be.
assets/
